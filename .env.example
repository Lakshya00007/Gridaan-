# ── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ⚠️  Service role key bypasses ALL Row Level Security — server-only, never expose to browser.
# If this key was ever committed to a public repo, ROTATE it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Payment Flags ────────────────────────────────────────────────────────────
# Gridaan is online-payment-only. Do not enable manual payment collection.
NEXT_PUBLIC_MANUAL_PAYMENT_ENABLED=false

# ── Razorpay Payments ────────────────────────────────────────────────────────
# Use Razorpay test keys outside production. Never expose key secret or webhook secret to browser code.
PAYMENT_PROVIDER=razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Public Business / Support Details ────────────────────────────────────────
# Published only from server-rendered pages. Leave absent until the mailbox exists.
SUPPORT_EMAIL=
# Optional. Rendered only when a valid, actual GSTIN is configured.
GSTIN=

# Publish grievance details only after all four values are verified.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_EMAIL=
GRIEVANCE_CONTACT_METHOD=
GRIEVANCE_RESPONSE_EXPECTATION=

# Operational estimates. Leave blank until the fulfilment team confirms them.
SHIPPING_DISPATCH_ESTIMATE=
SHIPPING_DELIVERY_ESTIMATE=
SHIPPING_REMOTE_AREA_ESTIMATE=
REFUND_INITIATION_ESTIMATE=

# -- NimbusPost Shipping ------------------------------------------------------
# Disabled until GRIDAAN has official endpoint-level NimbusPost API
# documentation from the seller panel/generated API credentials.
# Do not add NEXT_PUBLIC_NIMBUSPOST_* values. Provider credentials must remain
# server-only and should be added only after the official auth contract is known.
NIMBUSPOST_ENABLED=false

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# The verified public destination is centralized in src/lib/business-info.ts.

# Optional: WhatsApp Cloud API token (Meta). If absent, deep-links (wa.me) are used instead.
# WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ── Site ──────────────────────────────────────────────────────────────────────
# Set to your production domain in production — e.g. https://www.gridaan.com
# Used for canonical URLs, OG images, sitemap, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: Supabase Type Generation ───────────────────────────────────────
# Only needed for running: npm run supabase:types
# Get project ID from Supabase dashboard URL
# SUPABASE_PROJECT_ID=your_project_id_here
